{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "proseWrap": "always",
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSameLine": true,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "sortImports": {
    "internalPattern": ["@/", "@test/"]
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "ignorePatterns": [
    ".yarn",
    "dist",
    ".output",
    ".vinxi",
    ".turbo",
    "coverage",
    "**/*.timestamp_*.js",
    ".vitepress/cache",
    ".vitepress/dist",
    "apps/docs/reference/api",
    "**/routeTree.gen.ts"
  ]
}

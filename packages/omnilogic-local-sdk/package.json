{
  "name": "@rygine/omnilogic-local-sdk",
  "version": "0.0.6",
  "description": "TypeScript SDK for local control of Hayward OmniLogic pool controllers",
  "keywords": [
    "api",
    "controller",
    "hayward",
    "omnilogic",
    "pool",
    "typescript"
  ],
  "homepage": "https://github.com/rygine/omnilogic-local/tree/main/packages/omnilogic-local-sdk#readme",
  "bugs": {
    "url": "https://github.com/rygine/omnilogic-local/issues"
  },
  "license": "MIT",
  "author": "Ry Racherbaumer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rygine/omnilogic-local.git",
    "directory": "packages/omnilogic-local-sdk"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "prerelease"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf .turbo dist node_modules",
    "dev": "tsdown --watch",
    "prepack": "yarn build",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

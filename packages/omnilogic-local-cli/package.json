{
  "name": "@rygine/omnilogic-local-cli",
  "version": "0.0.5",
  "description": "Command line for local control of Hayward OmniLogic pool controllers",
  "keywords": [
    "cli",
    "hayward",
    "omnilogic",
    "pool"
  ],
  "homepage": "https://github.com/rygine/omnilogic-local/tree/main/packages/omnilogic-local-cli#readme",
  "bugs": {
    "url": "https://github.com/rygine/omnilogic-local/issues"
  },
  "license": "MIT",
  "author": "Ry Racherbaumer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rygine/omnilogic-local.git",
    "directory": "packages/omnilogic-local-cli"
  },
  "bin": {
    "omnilogic-local": "dist/index.js"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "tag": "prerelease"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf .turbo dist node_modules",
    "prepack": "yarn build",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rygine/omnilogic-local-sdk": "^0.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

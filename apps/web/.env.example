# copy to .env and adjust - read by the dev server on the host, and by
# compose.yaml and the dev/ scripts for the container

# holds app.db on the host. The container's path is pinned to /data in
# compose.yaml, and the host side of that mount is DATA_PATH below
DATA_DIR=./data

# SDK log level - trace | debug | info | warn | error | off
# LOG_LEVEL=debug

# container only: the port it listens on and publishes
PORT=3000

# container only: host interface the port is published on - 0.0.0.0 also
# bypasses ufw
BIND_ADDR=127.0.0.1

# container only: bind address inside it - 0.0.0.0 is required there
HOST=0.0.0.0

# container only: host directory mounted at /data, writable by uid 1000.
# dev/run.sh takes it as its argument instead
# DATA_PATH=./data
